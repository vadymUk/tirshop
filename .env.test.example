# Copy to .env.test (git-ignored). Used by `npm run test:db`.
# MUST point to a dedicated, disposable Supabase project with migrations 0001-0011 applied.
# These tests create and delete users, products and orders. NEVER use production keys.
TEST_SUPABASE_URL=
TEST_SUPABASE_PUBLISHABLE_KEY=
TEST_SUPABASE_SECRET_KEY=
ALLOW_DB_TESTS=true
