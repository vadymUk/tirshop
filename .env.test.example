# Copy to .env.test (git-ignored). Used by `npm run test:db`.
# MUST be a disposable local Supabase instance with migrations 0001-0026 applied.
# These tests create and delete users, products and orders. Remote projects are rejected.
TEST_SUPABASE_URL=http://127.0.0.1:54321
TEST_SUPABASE_PUBLISHABLE_KEY=
TEST_SUPABASE_SECRET_KEY=
ALLOW_DB_TESTS=true
