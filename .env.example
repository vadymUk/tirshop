# Public (safe for the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# "true" only if your Supabase plan includes Image Transformations (Pro+); otherwise keep "false"
NEXT_PUBLIC_SUPABASE_IMAGE_TRANSFORMS=false

# Server only - NEVER prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=your-secret-key
RESEND_API_KEY=re_your_api_key
# Must be on a domain verified in Resend (SPF/DKIM), e.g. orders@your-domain.com
RESEND_FROM_EMAIL="Truck Shop <orders@your-domain.com>"
# Receives a notification for every new order
SELLER_EMAIL=seller@your-domain.com
