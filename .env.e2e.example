# Copy to .env.e2e (git-ignored). Used by `npm run test:e2e`.
# Use a disposable local Supabase instance. Playwright starts its own local Next.js server.
E2E_ISOLATED=true
TEST_SUPABASE_URL=http://127.0.0.1:54321
TEST_SUPABASE_PUBLISHABLE_KEY=
TEST_SUPABASE_SECRET_KEY=
# Optional: dedicated, email-confirmed local customer for the authenticated storefront tests.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
# Optional: local Next.js port (must not already be in use).
# E2E_PORT=3000
# Optional: create a local order; outbound Resend email is disabled for this server.
# E2E_PLACE_ORDER=true
