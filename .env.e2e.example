# Copy to .env.e2e (git-ignored). Used by `npm run test:e2e`.
# Use a staging/test Supabase project and a dedicated, email-confirmed test account.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
# Optional: test an already running deployment instead of starting `npm run dev`
# E2E_BASE_URL=http://localhost:3000
# Optional: let the full order flow create a real order (and send emails)
# E2E_PLACE_ORDER=true
